              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Member\",\n  \"email\": \"member@test.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "const j = pm.response.json();",
                  "pm.test('has token', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.token);"
